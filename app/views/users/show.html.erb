<h1>User info</h1>
<div>
  <%= image_tag @user.get_profile_image(80,80), class: "profile-img" %>
</div>
<table>
  <tr>
    <th>name</th>
    <td><%= @user.name %></td>
  </tr>
  <tr>
    <th>introduction</th>
    <td><%= @user.introduction %></td>
  </tr>
</table>
<%= link_to "edit", edit_user_path(@user) %>