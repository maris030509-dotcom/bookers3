<h1>Books</h1>
<table>
  <thead>
    <tr>
      <th></th>
      <th>Title</th>
      <th>Opinion</th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td>
          <%= link_to user_path(book.user) do %>
            <%= image_tag book.user.get_profile_image(80,80), class: "profile-img",size: "80x80" %>
            <% book.user.name %>
          <% end %>
        </td>
        <td>
          <%= link_to book.title, book_path(book) %>
        </td>
        <td><%= book.body %></td>
      </tr>
    <% end %>
  </tbody>

</table>