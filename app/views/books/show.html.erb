<h1>Book detail</h1>
<table>
  <tbody>
    <tr>
      <td>
        <%= link_to user_path(@book.user) do %>
          <%= image_tag @book.user.get_profile_image(80,80), class: "profile-img", size: "80x80" %>
        <% end %>
      </td>
      <td><%= @book.title %></td>
      <td><%= @book.body %></td>
    </tr>
  </tbody>
</table>